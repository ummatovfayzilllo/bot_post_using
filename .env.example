# Application
PORT=3000
NODE_ENV=development

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_IDS=123456789,987654321

# Primary Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bot_post_db?schema=public"

# Backup Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017/bot_post_backup_db"

# State & Backup Cache (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
